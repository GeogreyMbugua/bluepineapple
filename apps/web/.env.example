# ── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.bluepineappleholdings.com
NEXT_PUBLIC_API_URL=https://www.bluepineappleholdings.com/api

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/blue_pineapple
# Optional: Neon direct URL for local dev (avoids pooler timeouts on long-running servers)
# DATABASE_URL_UNPOOLED=postgresql://...@...neon.tech/neondb
REDIS_URL=redis://localhost:6380

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-key-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-key-change-in-production

# ── Clerk Authentication ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_JS=https://cdn.jsdelivr.net/npm/@clerk/clerk-js@6/dist/clerk.browser.js

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Daraja / M-Pesa Express (STK Push) — Buy Goods Till (preferred) ───────────
# sandbox | production
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# HO / store shortcode used as BusinessShortCode (and in the STK password)
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Till number credited on Buy Goods STK (PartyB) — required for CustomerBuyGoodsOnline
DARAJA_PARTY_B=
# Public HTTPS URL Safaricom will POST STK results to
DARAJA_CALLBACK_URL=https://your-tunnel.example/api/payments/mpesa/callback
# CustomerBuyGoodsOnline (Till, preferred) | CustomerPayBillOnline (Paybill)
DARAJA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# Optional: restrict callback handling to Safaricom gateway IPs (true in production)
# DARAJA_ENFORCE_CALLBACK_IP=true
# Protect POST /api/payments/mpesa/reconcile — required when DARAJA_ENV=production
# DARAJA_RECONCILE_SECRET=
